### Добавить новое место
POST http://localhost:8080/api/v1/places/add
Content-Type: application/json

{
  "id": "place_021",
  "name": {"ru": "Казанский Кремль", "en": "Kazan Kremlin"},
  "category": "HISTORICAL_BUILDING",
  "latitude": 55.7986,
  "longitude": 49.1064,
  "address": {"ru": "Кремль, Казань", "en": "Kremlin, Kazan"},
  "description": "Главная достопримечательность Казани.",
  "rating": 4.9,
  "images": ["https://example.com/kazan_1.jpg"]
}